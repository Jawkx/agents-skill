{
  "mcpServers": {
    "argent": {
      "transport": "stdio",
      "command": "argent",
      "args": ["mcp"],
      "lifecycle": "eager"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "todoist": {
      "url": "https://ai.todoist.net/mcp"
    },
    "doop": {
      "type": "http",
      "url": "https://doop.design/mcp"
    }
  },
}
